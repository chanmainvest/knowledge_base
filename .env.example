# Copy to .env and fill in. NEVER commit .env.

# ---- MacroVoices ----
MACROVOICES_USER=your_user
MACROVOICES_PASS=your_pass

# ---- HKEJ (Hong Kong Economic Journal) ----
HKEJ_USER=your_email
HKEJ_PASS=your_pass

# ---- HKEJ browser / Camoufox (Docker is the default) ----
# HKEJ sits behind Cloudflare, so it needs a real (anti-detect) browser. By
# default the browser runs in a Docker container exposing a Playwright WS
# endpoint; `kb hkej docker up` starts it. Set HKEJ_BROWSER_MODE=local to fall
# back to an on-host Camoufox via the daemon (kb hkej browser start).
HKEJ_BROWSER_MODE=docker          # docker | local
HKEJ_LOGIN_MODE=auto              # auto (HKEJ_USER/PASS → auto-fill, else manual) | manual
HKEJ_CAMOUFOX_ENDPOINT=ws://127.0.0.1:9222/hkej   # Playwright WS endpoint of the container
HKEJ_DOCKER_IMAGE=kb-camoufox:latest              # built from docker/camoufox (docker compose build)
HKEJ_DOCKER_CONTAINER=kb_camoufox                 # container name used by `kb hkej docker ...`
HKEJ_CAMOUFOX_PORT=9222           # host port → container WS endpoint
HKEJ_DOCKER_NOVNC_PORT=7900       # host port → container noVNC web UI (interactive Cloudflare/login)

# ---- Patreon (browser session_id cookie; DevTools → Application → Cookies) ----
PATREON_SESSION_ID=

# ---- Substack (browser substack.sid cookie; DevTools → Application → Cookies) ----
# Not required for free publications/posts — only needed to read posts on a
# paid subscription. Prefer `kb substack prime-session` (interactive login,
# saves the cookie for you) over pasting it here.
SUBSTACK_SESSION_COOKIE=

# ---- LLM: pick the default provider `kb extract run` uses, and (separately)
# the provider used for embeddings (only openai/zai support embeddings today) ----
LLM_PROVIDER=zai                 # openai | github | anthropic | zai (zai = GLM direct)
LLM_EMBEDDING_PROVIDER=zai       # openai | zai

# openai (OpenAI-compatible; also works with Azure OpenAI, local llama.cpp/Ollama
# by pointing LLM_BASE_URL at them)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small

# LLM retry / rate-limit backoff. chat_json()/embed() retry transient errors
# and HTTP 429s with a quiet period: honour the server's Retry-After header when
# present, otherwise pause LLM_RATE_LIMIT_PAUSE_SEC for a 429. Raise these to
# ride through provider-side throttling (e.g. OpenRouter free-tier 429s).
LLM_MAX_RETRIES=8
LLM_RATE_LIMIT_PAUSE_SEC=20

# Extraction prompt/schema version pin (directory name under
# src/kb/prompts/extraction/). Empty = always use the highest version
# present, so adding a new version directory adopts it on the next run.
# Per-invocation override: `kb extract run --prompt-version <v>`.
EXTRACTION_PROMPT_VERSION=

# github: shells out to the local `copilot` CLI (this tool) in non-interactive
# mode; no API key needed here, just `copilot /login` once on this machine.
GITHUB_CLI_PATH=copilot
GITHUB_MODEL=                    # empty = let the CLI pick its own default
GITHUB_CLI_TIMEOUT_SEC=180

# anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=              # empty = https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# zai (Z.ai / Zhipu GLM, OpenAI-compatible endpoint)
ZAI_API_KEY=...
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.3
ZAI_EMBEDDING_MODEL=embedding-3

# ---- Data directory ----
# Where scraped markdown and raw HTML are stored. Relative paths resolve
# against the repo root; absolute paths are used as-is.
DATA_DIR=data

# ---- Postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5544
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb_local_dev
POSTGRES_DB=kb

# ---- Scraper behaviour ----
SCRAPE_RATE_LIMIT_SEC=3        # min seconds between requests per host
HKEJ_RATE_LIMIT_SEC=5          # HKEJ browser page loads (Camoufox; slower than httpx)
PATREON_RATE_LIMIT_SEC=5       # Patreon internal API requests (min seconds per host)
SUBSTACK_RATE_LIMIT_SEC=3      # Substack public archive/post API (min seconds per host)
YOUTUBE_RATE_LIMIT_SEC=5       # YouTube subtitle/timedtext endpoint 429s hard; adaptive backoff on top
YOUTUBE_DIRECT_RATE_LIMIT_SEC=15  # used when the proxy pool is dead and yt-dlp goes direct — slows the single IP proactively
SCRAPE_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) KB-Personal/0.1"
SCRAPE_MAX_RETRIES=3
YT_DLP_COOKIES_FROM_BROWSER=   # e.g. "chrome" or "firefox" if a channel needs login
# Optional SOCKS5 proxy for yt-dlp to avoid per-IP rate limiting (HTTP 429).
# Auto-tunnels: comma-separated SSH host aliases — the scraper opens one
# `ssh -D` tunnel per host and round-robins requests across them.
# Available hosts: hevangel.com, oc1/2/3/4.hevangel.com, horace.org, serv00
YT_DLP_PROXY_HOSTS=            # e.g. "oc1.hevangel.com,oc2.hevangel.com,serv00"
SSH_KEY_DIR=C:/Users/you/.ssh  # absolute host path of ~/.ssh (mounted into the kb container; never use ${HOME} — Jenkins resolves it differently)
# Absolute HOST paths of the repo's data/ and logs/ dirs for the `kb` compose
# service. Without these, a relative ./data source resolves INSIDE the Docker
# Desktop VM when Jenkins runs compose from its container — the daemon mounts
# an orphan dir there and nightly scrapes never reach the real drive.
# /host_mnt/<drive>/... is the Docker Desktop in-VM alias for a Windows drive.
DATA_DIR_HOST=/host_mnt/b/chanmainvest/knowledge_base/data
LOGS_DIR_HOST=/host_mnt/b/chanmainvest/knowledge_base/logs
# Or a single manual tunnel you've opened yourself (e.g. `ssh -D 1080 -N host`):
YT_DLP_PROXY=                  # e.g. "socks5://127.0.0.1:1080"
PATREON_COOKIES_FROM_BROWSER=  # e.g. "chrome" or "edge" — auto-read session_id cookie
SUBSTACK_COOKIES_FROM_BROWSER= # e.g. "chrome" or "edge" — auto-read substack.sid cookie

# ---- ASR transcription ----
# For YouTube videos with no subtitle/transcript (has_transcript=false),
# `kb youtube transcribe` (or `kb youtube scrape --transcribe`) downloads the
# audio and runs ASR on GPU. One video at a time (sequential) to keep GPU
# thermals in check. Disabled by default — transcription only runs when
# explicitly requested (WHISPER_ENABLED=true or the --transcribe flag).
# Audio files are stored in WHISPER_TMP_DIR (gitignored) and deleted after use.
TRANSCRIBE_ENGINE=qwen          # qwen (default) | whisper (legacy faster-whisper)
# qwen engine — Qwen3-ASR via the `qwen-asr` package (needs CUDA torch).
# Verbatim Cantonese output; long audio is decoded to 16 kHz WAV via ffmpeg
# and transcribed in QWEN_CHUNK_SEC chunks (full-context decode collapses
# past ~12 min on an 8 GB card).
QWEN_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_DEVICE=cuda:0              # torch device_map value
QWEN_CHUNK_SEC=480              # chunk length in seconds (8 min ≈ 2x realtime on RTX 3060 Ti)
QWEN_MAX_NEW_TOKENS=8192        # per chunk
QWEN_HF_HOME=                   # empty = leave HF_HOME alone; or point at a local HF cache to skip the ~4.7 GB weight download
# whisper engine — faster-whisper (legacy). Fast on any length (6-7.7x
# realtime) but normalises colloquial Cantonese into 書面語.
WHISPER_ENABLED=false           # master switch for `kb youtube scrape --transcribe`
WHISPER_MODEL=large-v3          # faster-whisper model: tiny|base|small|medium|large-v3
WHISPER_DEVICE=cuda             # cuda | cpu
WHISPER_COMPUTE_TYPE=float16    # float16 (GPU), int8 (CPU)
WHISPER_BEAM_SIZE=5             # beam search width (higher = more accurate, slower)
WHISPER_LANGUAGE=               # empty = auto-detect, or "en"/"yue"/"zh"/etc.
WHISPER_MAX_DURATION_SEC=0      # 0 = no limit; otherwise skip videos longer than this (seconds)
WHISPER_TMP_DIR=raw/youtube/tmp # relative to DATA_DIR (data/raw/<source>/ layout), gitignored

# ---- API ----
API_HOST=127.0.0.1
API_PORT=8088
